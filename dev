#!/usr/bin/env bash
# The edit-and-try loop: the page from Vite with hot reload, and `gecko`
# behind it so scripts can still reach real files.
#
#   ./dev
#
# A TypeScript edit reloads the page in place. A Rust edit means building
# the kernel again — run this once more.
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.cargo/bin:$PATH"

export GECKO_PORT="${GECKO_PORT:-8731}"

source scripts/ports.sh
require_free 5173 "the dev server"
require_free "$GECKO_PORT" "the file server"

[ -d node_modules ] || npm install --no-audit --no-fund
[ -d front/node_modules ] || (cd front && npm install --no-audit --no-fund)

echo "── the kernel, and the interpreter ───────────────────────────"
./build-wasm.sh
./build-lua.sh

echo "── a file server, for scripts that read and write ────────────"
cargo build --release -p gecko-cli
./target/release/gecko --port "$GECKO_PORT" --no-open &
server=$!
trap 'kill $server 2>/dev/null || true' EXIT

echo "── the page, with hot reload ─────────────────────────────────"
echo "   http://localhost:5173/"
(cd front && npx vite --host 127.0.0.1)
